# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/chat_agent"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# LLM (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"

# Available models:
# - gemini-1.5-flash (recommended - faster, higher free tier quota)
# - gemini-1.5-pro (more capable but lower quota)
# - gemini-2.0-flash-exp (experimental, very limited quota)

# CORS
FRONTEND_URL="http://localhost:3000"
